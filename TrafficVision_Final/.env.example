# Copy this file to ".env" and fill in your Gemini API key if you want AI-generated advisories.
# If left unset, TrafficVision automatically uses the built-in rule-based fallback advisory.
GEMINI_API_KEY=your_api_key_here

# Optional: Gemini model name
GEMINI_MODEL=gemini-2.5-flash

# Optional: API request timeout in seconds
LLM_TIMEOUT_SECONDS=20
