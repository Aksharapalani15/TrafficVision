# Copy this file to ".env" and fill in your own key.
# NEVER commit the real .env file (it is listed in .gitignore).
GEMINI_API_KEY=your_api_key_here

# Optional: model name. Check Google AI Studio for currently available models.
GEMINI_MODEL=gemini-2.5-flash

# Optional: seconds to wait for the API before using the fallback.
LLM_TIMEOUT_SECONDS=20
